#!/bin/bash
#SBATCH -J windinet_dit_4gpu
###-------------------------------------
#SBATCH -p lrz-hgx-h100-94x4
###------------------------------------
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=92
#SBATCH --time=18:00:00
#SBATCH --gres=gpu:4  #gpus per node
#SBATCH -o logs/lrz_ai/%j-%x.out
#SBATCH -e logs/lrz_ai/%j-%x.err

# 4-GPU variant of jobs/lrz_ai/train_dit.job -- same script, only the
# #SBATCH --gres/--cpus-per-task/--time header differs (accelerate launch's
# --num_processes below is already derived from SLURM_GPUS_ON_NODE, not
# hard-coded, so nothing else needed to change). --cpus-per-task=92 reuses
# the confirmed-working 4-GPU value from jobs/lrz_ai/finetune_vae_4gpu.job
# (job 5757490) -- see that script's header for how 92 (not sinfo's raw 96,
# and not 94 from the partition name) was derived.
#
# --time=18:00:00 (2026-08-30 default, was a 10:00:00 USER-CHOSEN CEILING
# set 2026-08-26) is still not a calibrated estimate -- DiT training here
# needs its wall-clock shortened (real steps/second at 256res's 896-token
# sequence length, see configs/shockwavenet_lrz_ai.yaml's own header, is not
# yet fast enough to comfortably finish optimization.steps in this window).
# Same caution as train_dit.job's own --time=18:00:00: check the step rate
# after the first few hundred steps and be ready to lower optimization.steps
# rather than assume this is enough to reach it. If the job is killed by the
# time limit, LtxvTrainer._load_checkpoint only restores transformer
# weights, not optimizer/scheduler state, so a resume restarts the cosine
# schedule from the top rather than continuing it -- same as
# jobs/sng_pvc/train_dit.sbatch and jobs/lundquist/train_dit.sbatch already
# carry.
#
# Submit from the repo root so the #SBATCH -o/-e paths above resolve:
#   sbatch jobs/lrz_ai/train_dit_4gpu.job <PREPROCESSED_NAME> [BASE_CONFIG]
#
# PREPROCESSED_NAME is REQUIRED, no default: it must match the OUTPUT_NAME
# jobs/lrz_ai/preprocess_dit_data.job encoded with (that job's default is
# the VAE run's own directory name) -- this job reads
# /mnt/result/dit_preprocessed/<PREPROCESSED_NAME>/. As of 2026-08-24,
# preprocessing has been run for four VAE variants (see
# logs/lrz_ai/INDEX.tsv): the ep30_256res baseline, kl1e6,
# kl1e5, and anchor_kl1e7.
#
# $2 (optional) overrides BASE_CONFIG, default
# configs/shockwavenet_lrz_ai.yaml -- the tunable knobs (scalar
# conditioning, optimizer/scheduler, flow-matching timestep sampling,
# checkpoint/validation cadence) all live there, not in this script.

echo "Directory where err and out file are logged: ${SLURM_SUBMIT_DIR}"

if [ -z "${1:-}" ]; then
    echo "error: PREPROCESSED_NAME is required -- the <name> jobs/lrz_ai/preprocess_dit_data.job wrote to" >&2
    echo "  usage: sbatch jobs/lrz_ai/train_dit_4gpu.job <PREPROCESSED_NAME> [BASE_CONFIG]" >&2
    exit 1
fi
export PREPROCESSED_NAME=$1

export RESULT_DIR=/dss/dssfs02/pn82ku/pn82ku-dss-0000/neptuna_stuff/work_wh/windinet/finetune_vae_baseline
export BASE_CONFIG=${2:-configs/shockwavenet_lrz_ai.yaml}

echo "PREPROCESSED_NAME: ${PREPROCESSED_NAME}"
echo "BASE_CONFIG: ${BASE_CONFIG}"

export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
echo "MASTER_ADDR: $MASTER_ADDR"
export MASTER_PORT=$(python - <<'PY'
import socket
s = socket.socket()
s.bind(('', 0))
print(s.getsockname()[1])
s.close()
PY
)
echo "MASTER_PORT: $MASTER_PORT"
echo "SLURM_GPUS_PER_NODE: $SLURM_GPUS_ON_NODE"

INNER_SCRIPT="${HOME}/.windinet_lrz_ai_dit_${SLURM_JOB_ID}.sh"
trap 'rm -f "${INNER_SCRIPT}"' EXIT
cat > "${INNER_SCRIPT}" <<'INNER'
set -eo pipefail
eval "$(conda shell.bash hook)"
conda activate windinet
export CUBLAS_WORKSPACE_CONFIG=:4096:8
export PYTHONPATH="$(pwd):$PYTHONPATH"
export RUN_CONFIG="/tmp/dit_run_${SLURM_JOB_ID}.yaml"

# Substitute the __PREPROCESSED_ROOT__ placeholder for the real container
# path, same pattern as finetune_vae_*.job's python patch step (but no
# windinet.cluster_config helper here -- the DiT config schema is
# data.preprocessed_data_root/validation.data_root, not VAE trainer's
# data.data_root, so it isn't the function that module exposes).
python -c '
import os, yaml
cfg = yaml.safe_load(open(os.environ["BASE_CONFIG"]))
root = "/mnt/result/dit_preprocessed/" + os.environ["PREPROCESSED_NAME"]
cfg["data"]["preprocessed_data_root"] = cfg["data"]["preprocessed_data_root"].replace("__PREPROCESSED_ROOT__", root)
cfg["validation"]["data_root"] = cfg["validation"]["data_root"].replace("__PREPROCESSED_ROOT__", root)
yaml.safe_dump(cfg, open(os.environ["RUN_CONFIG"], "w"), sort_keys=False)
print("preprocessed_data_root=" + cfg["data"]["preprocessed_data_root"] + " output_dir=" + cfg["output_dir"])
'

printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "${SLURM_JOB_ID}" "${SLURM_JOB_NAME}" \
    "${BASE_CONFIG}" "${PREPROCESSED_NAME}" >> logs/lrz_ai/INDEX.tsv

accelerate launch \
    --num_processes ${SLURM_GPUS_ON_NODE} \
    --mixed_precision bf16 \
    scripts/train.py "${RUN_CONFIG}"

# Mirror non-checkpoint outputs back onto the repo checkout (epoch_log.json,
# training_config.yaml, latent_provenance.json) -- not checkpoints/ (7.7GB
# fp32 state_dicts per save), same convention as the VAE jobs.
OUT_DIR=$(python -c 'import os, yaml; print(yaml.safe_load(open(os.environ["RUN_CONFIG"]))["output_dir"])')
LOCAL_DIR="finetune_vae_outputs/lrz_ai/dit_${PREPROCESSED_NAME}"
mkdir -p "${LOCAL_DIR}"
rsync -a --exclude='checkpoints/' "${OUT_DIR}/" "${LOCAL_DIR}/"
echo "Mirrored (excl. checkpoints/) to ${LOCAL_DIR}"
INNER

start_time=$(date +%s)
echo "Job started at: $(date)"

srun \
  --container-image="/dss/dsshome1/09/ge26qux3/windinet1.sqsh" \
  --container-mounts=$HOME:$HOME,$RESULT_DIR:/mnt/result \
  --container-workdir="$HOME/work_wh/windinet" \
  --export=ALL,MASTER_PORT,MASTER_ADDR,BASE_CONFIG,PREPROCESSED_NAME \
  bash "${INNER_SCRIPT}"

end_time=$(date +%s)
echo "Job finished at: $(date)"
echo "Total runtime: $((end_time - start_time)) seconds"
