#!/bin/bash
#SBATCH -J windinet_dit_inference
###-------------------------------------
#SBATCH -p lrz-hgx-h100-94x4
###------------------------------------
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
#SBATCH --time=00:30:00
#SBATCH --gres=gpu:1
#SBATCH -o logs/lrz_ai/%j-%x.out
#SBATCH -e logs/lrz_ai/%j-%x.err

# Rollout a trained DiT checkpoint on a few held-out sims and render GT vs
# prediction videos, instead of judging a run by val_loss alone. Companion
# to jobs/lrz_ai/train_dit*.job -- point this at one of their checkpoints.
# Single GPU: this is inference (batch_size 1, forward-only), not training,
# doesn't need the 2/4-GPU allocation those jobs use.
#
# --time=00:30:00 is an UNCALIBRATED GUESS (2026-08-29) -- no DiT inference
# has been run on this pipeline yet to measure it against. Budget: model
# load (~2-5 min) + NUM_SAMPLES x 20 denoising steps on a single 2B-param
# transformer at 896 tokens (seconds, not minutes, per step on an H100) +
# rendering NUM_SAMPLES x ~100-frame GT/Pred/Residual videos with matplotlib
# (the slow part -- maybe 1-2 min/sample). If it times out, bump --time and
# rerun rather than assume the estimate was closer than it looks.
#
# Submit from the repo root so the #SBATCH -o/-e paths above resolve:
#   sbatch jobs/lrz_ai/inference_dit.job <PREPROCESSED_NAME> <DIT_CHECKPOINT> <VAE_CHECKPOINT> [NUM_SAMPLES] [DATA_DIR]
#
# PREPROCESSED_NAME: the dit_preprocessed/<name> this checkpoint's latents
#   came from (same value passed to jobs/lrz_ai/train_dit*.job) -- used to
#   find that run's normalization.json.
# DIT_CHECKPOINT: full container path to the exact model_weights_step_*.safetensors
#   file (not the checkpoints/ dir -- avoids the scalar_embedding_step_*
#   glob-tie ambiguity, same reasoning as configs/shockwavenet_lrz_ai_resume.yaml).
#   The sibling scalar_embedding_step_*.safetensors is derived automatically.
#   e.g. /mnt/result/shockwave_dit/checkpoints/model_weights_step_06000.safetensors
# VAE_CHECKPOINT: full container path to the vae_shockwave_best.safetensors
#   this PREPROCESSED_NAME was encoded with -- REQUIRED, no default, because
#   its exact location wasn't verified when this job was written. Confirm it
#   exists before submitting:
#     ls <RESULT_DIR below>/.../checkpoints/vae_shockwave_best.safetensors
# NUM_SAMPLES: optional, default 4.
# DATA_DIR: optional, default matches jobs/lrz_ai/preprocess_dit_data.job's
#   own default (256x256_ds) -- must be the same dataset that VAE checkpoint
#   was encoded from.

echo "Directory where err and out file are logged: ${SLURM_SUBMIT_DIR}"

if [ -z "${1:-}" ] || [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
    echo "error: PREPROCESSED_NAME, DIT_CHECKPOINT, and VAE_CHECKPOINT are all required" >&2
    echo "  usage: sbatch jobs/lrz_ai/inference_dit.job <PREPROCESSED_NAME> <DIT_CHECKPOINT> <VAE_CHECKPOINT> [NUM_SAMPLES] [DATA_DIR]" >&2
    exit 1
fi
export PREPROCESSED_NAME=$1
export DIT_CHECKPOINT=$2
export VAE_CHECKPOINT=$3
export NUM_SAMPLES=${4:-4}

export RESULT_DIR=/dss/dssfs02/pn82ku/pn82ku-dss-0000/neptuna_stuff/work_wh/windinet/finetune_vae_baseline
export DATA_DIR=${5:-/dss/dssfs02/pn82ku/pn82ku-dss-0000/neptuna_stuff/datasets/Euler_MQ/data/256x256_ds}
export BASE_CONFIG=configs/inference_shockwave_lrz_ai.yaml

# Sibling file, same convention as the resume config's own comment: model_
# weights and scalar_embedding checkpoints for the same step live next to
# each other under the same checkpoints/ dir.
export SCALAR_CHECKPOINT=${DIT_CHECKPOINT/model_weights_step_/scalar_embedding_step_}

echo "PREPROCESSED_NAME: ${PREPROCESSED_NAME}"
echo "DIT_CHECKPOINT: ${DIT_CHECKPOINT}"
echo "SCALAR_CHECKPOINT: ${SCALAR_CHECKPOINT}"
echo "VAE_CHECKPOINT: ${VAE_CHECKPOINT}"
echo "NUM_SAMPLES: ${NUM_SAMPLES}"

INNER_SCRIPT="${HOME}/.windinet_lrz_ai_inference_${SLURM_JOB_ID}.sh"
trap 'rm -f "${INNER_SCRIPT}"' EXIT
cat > "${INNER_SCRIPT}" <<'INNER'
set -eo pipefail
eval "$(conda shell.bash hook)"
conda activate windinet
export PYTHONPATH="$(pwd):$PYTHONPATH"
export RUN_CONFIG="/tmp/inference_run_${SLURM_JOB_ID}.yaml"

# Substitute the __PREPROCESSED_ROOT__ placeholder in `normalization` --
# the only field in configs/inference_shockwave_lrz_ai.yaml that isn't
# CLI-overridable (see scripts/inference_shockwave.py's parse_args).
python -c '
import os, yaml
cfg = yaml.safe_load(open(os.environ["BASE_CONFIG"]))
root = "/mnt/result/dit_preprocessed/" + os.environ["PREPROCESSED_NAME"]
cfg["normalization"] = cfg["normalization"].replace("__PREPROCESSED_ROOT__", root)
yaml.safe_dump(cfg, open(os.environ["RUN_CONFIG"], "w"), sort_keys=False)
print("normalization=" + cfg["normalization"])
'

STEP_LABEL=$(basename "${DIT_CHECKPOINT}" .safetensors)
OUT_DIR="/mnt/result/inference/${PREPROCESSED_NAME}/${STEP_LABEL}"
mkdir -p "${OUT_DIR}"

python scripts/inference_shockwave.py "${RUN_CONFIG}" \
    --h5 /mnt/data/train.h5 \
    --checkpoint "${DIT_CHECKPOINT}" \
    --scalar_checkpoint "${SCALAR_CHECKPOINT}" \
    --vae_checkpoint "${VAE_CHECKPOINT}" \
    --out_dir "${OUT_DIR}" \
    --num_samples "${NUM_SAMPLES}"

python scripts/visualize_dit_predictions.py \
    --pred_dir "${OUT_DIR}" \
    --h5 /mnt/data/train.h5 \
    --out_dir "${OUT_DIR}/videos"

# Videos are small (a handful of MB each) -- mirror them back onto the repo
# checkout so they don't only exist on lrz_ai's DSS, same convention as
# train_dit.job rsyncing non-checkpoint outputs back (just this job has no
# large checkpoints/ dir of its own to exclude).
LOCAL_DIR="finetune_vae_outputs/lrz_ai/inference/${PREPROCESSED_NAME}/${STEP_LABEL}"
mkdir -p "${LOCAL_DIR}"
rsync -a "${OUT_DIR}/videos/" "${LOCAL_DIR}/videos/"
echo "Mirrored videos to ${LOCAL_DIR}/videos/"
INNER

start_time=$(date +%s)
echo "Job started at: $(date)"

srun \
  --container-image="/dss/dsshome1/09/ge26qux3/windinet1.sqsh" \
  --container-mounts=$HOME:$HOME,$RESULT_DIR:/mnt/result,$DATA_DIR:/mnt/data \
  --container-workdir="$HOME/work_wh/windinet" \
  --export=ALL,PREPROCESSED_NAME,DIT_CHECKPOINT,SCALAR_CHECKPOINT,VAE_CHECKPOINT,NUM_SAMPLES,BASE_CONFIG \
  bash "${INNER_SCRIPT}"

end_time=$(date +%s)
echo "Job finished at: $(date)"
echo "Total runtime: $((end_time - start_time)) seconds"
