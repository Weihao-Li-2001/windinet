#!/bin/bash
#SBATCH -J windinet_test
###-------------------------------------
#SBATCH -p lrz-hgx-h100-94x4
###------------------------------------
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=48
#SBATCH --time=06:00:00
#SBATCH --gres=gpu:1  #gpus per node (fixed for nvidia-h100)
#SBATCH -o log_finetuning_vae/lrz_ai/%j-%x.out
#SBATCH -e log_finetuning_vae/lrz_ai/%j-%x.err

# 1-GPU launcher for the lrz_ai cluster (H100, enroot/pyxis container).
# Submit from the repo root so the #SBATCH -o/-e paths above resolve, same
# convention as jobs/sng_pvc/*.sbatch:
#   sbatch jobs/lrz_ai/finetune_vae_1gpu.job [configs/finetune_vae/<your-config>.yaml]
#
# $2 (optional) overrides DATA_DIR (a directory, container-mounted whole to
# /mnt/data -- NOT a train.h5 path), e.g. to train against a resolution
# other than the default 128x128_ds. Same purpose as jobs/sng_pvc/
# finetune_vae.sbatch's $2, but that one overrides data_root directly since
# sng_pvc has no container mount step to redirect instead:
#   sbatch jobs/lrz_ai/finetune_vae_1gpu.job configs/finetune_vae/<your-config>.yaml \
#       /dss/dssfs02/pn82ku/pn82ku-dss-0000/neptuna_stuff/datasets/Euler_MQ/data/256x256_ds
# Path above is an unverified analogy to the 128x128_ds one below -- confirm
# it exists on lrz_ai's DSS before relying on it, this repo checkout can't
# check that from here.
#
# CONTAINER MOUNTS (see srun below): $HOME -> $HOME (1:1, so the repo
# checkout at $HOME/work_wh/windinet is visible at the same path inside the
# container -- this is what lets the inner script and the mirror-back step
# just use repo-relative paths), $RESULT_DIR -> /mnt/result, $DATA_DIR ->
# /mnt/data. $RESULT_DIR/$DATA_DIR are real DSS paths, NOT the git repo --
# training writes under /mnt/result, which is why the mirror-back step
# below exists (same reason jobs/sng_pvc/finetune_vae.sbatch has one: the
# git-tracked history is finetune_vae_outputs/lrz_ai/<run>/, not $RESULT_DIR
# itself, which is scratch-like DSS space outside the repo).

echo "Directory where err and out file are logged: ${SLURM_SUBMIT_DIR}"

export RESULT_DIR=/dss/dssfs02/pn82ku/pn82ku-dss-0000/neptuna_stuff/work_wh/windinet/finetune_vae_baseline
export DATA_DIR=${2:-/dss/dssfs02/pn82ku/pn82ku-dss-0000/neptuna_stuff/datasets/Euler_MQ/data/128x128_ds}
export WINDINET_HF_CACHE=/mnt/result/hf_cache
# windinet/__init__.py redirects the HuggingFace hub cache to
# <repo_root>/pretrained/hub by default (see windinet/paths.py) -- fine on
# lundquist/sng_pvc where the checkout lives on generous local/scratch
# disk, but $HOME here is DSS-quota'd and the checkout lives under it: a
# first attempt without this override hit "Disk quota exceeded" downloading
# the ~8.4GB base weights (job 5750198, 2026-08-15). /mnt/result is
# $RESULT_DIR's much larger DSS project quota, already bind-mounted below.

# Base config to patch; override with: sbatch jobs/lrz_ai/finetune_vae_1gpu.job configs/finetune_vae/<your-config>.yaml
export BASE_CONFIG=${1:-configs/finetune_vae/finetune_vae_baseline.yaml}

# Rendezvous settings
export MASTER_ADDR=$(scontrol show hostname $SLURM_NODELIST | head -n 1)
echo "MASTER_ADDR: $MASTER_ADDR"

# Pick a free port on this node
export MASTER_PORT=$(python - <<'PY'
import socket
s = socket.socket()
s.bind(('', 0))
print(s.getsockname()[1])
s.close()
PY
)
echo "MASTER_PORT: $MASTER_PORT"
echo "SLURM_NODEID: $SLURM_NODEID"
echo "SLURM_NNODES: $SLURM_NNODES"

# World size = number of GPUs on this node
echo "SLURM_GPUS_PER_NODE: $SLURM_GPUS_ON_NODE"
export WORLD_SIZE=$(($SLURM_NNODES * $SLURM_GPUS_ON_NODE))
echo "WORLD_SIZE: $WORLD_SIZE"

export CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((WORLD_SIZE-1)))
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"

# Everything that has to run inside the container (config patch, training,
# mirroring the run back onto the DSS-backed repo checkout) lives in its own
# script instead of one giant escaped `bash -lc "..."` string -- $HOME is
# bind-mounted 1:1 into the container below, so a script written here on the
# host is visible at the same path inside the container. Cleaned up on exit.
INNER_SCRIPT="${HOME}/.windinet_lrz_ai_run_${SLURM_JOB_ID}.sh"
trap 'rm -f "${INNER_SCRIPT}"' EXIT
cat > "${INNER_SCRIPT}" <<'INNER'
set -eo pipefail
# `conda activate` refuses to run in a non-interactive shell (this script)
# until the shell has sourced conda's own init hook -- `conda init` writes
# that sourcing into ~/.bashrc, which non-interactive shells don't load.
# `conda shell.bash hook` re-derives the same hook from the `conda` binary
# already on PATH inside the container, so this doesn't depend on knowing
# the image's conda install path (miniconda/mambaforge/system, wherever it
# lives). Without this, jobs died in ~1 minute with "CondaError: Run
# 'conda init' before 'conda activate'" (jobs 5744998/5744999, 2026-08-12).
eval "$(conda shell.bash hook)"
conda activate windinet
export CUBLAS_WORKSPACE_CONFIG=:4096:8
export PYTHONPATH="$(pwd):$PYTHONPATH"
mkdir -p "${WINDINET_HF_CACHE}"
export RUN_CONFIG="/tmp/finetune_vae_run_${SLURM_JOB_ID}.yaml"

python -c '
import os, yaml
from windinet.cluster_config import patch_config_for_cluster
cfg = yaml.safe_load(open(os.environ["BASE_CONFIG"]))
patch_config_for_cluster(cfg, cluster="lrz_ai", num_processes=int(os.environ["SLURM_GPUS_ON_NODE"]), output_suffix="")
yaml.safe_dump(cfg, open(os.environ["RUN_CONFIG"], "w"), sort_keys=False)
print("output_dir=" + cfg["output_dir"] + " data_root=" + cfg["data"]["data_root"])
'
OUT_DIR=$(python -c 'import os, yaml; print(yaml.safe_load(open(os.environ["RUN_CONFIG"]))["output_dir"])')

# Make log_finetuning_vae/lrz_ai/ self-describing: one row per job mapping
# the log to the config it ran and the output_dir it wrote, same convention
# as log_finetuning_vae/{sng_pvc,lundquist}/INDEX.tsv.
printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "${SLURM_JOB_ID}" "${SLURM_JOB_NAME}" \
    "${BASE_CONFIG}" "${OUT_DIR}" >> log_finetuning_vae/lrz_ai/INDEX.tsv

torchrun \
  --nnodes=${SLURM_JOB_NUM_NODES} \
  --nproc_per_node=${SLURM_GPUS_ON_NODE} \
  --rdzv_id=${SLURM_JOB_ID} \
  --rdzv_endpoint="${MASTER_ADDR}:${MASTER_PORT}" \
  --rdzv-backend=c10d \
  scripts/finetune_vae.py "${RUN_CONFIG}"

# Mirror the run's visualizations/metrics/config back onto the DSS-backed
# repo checkout so they're browsable without touching $RESULT_DIR -- but not
# checkpoints/ (weights + optimizer state), which stay on $RESULT_DIR only
# (large, and already addressed via OUT_DIR in
# log_finetuning_vae/lrz_ai/INDEX.tsv). Same pattern as
# jobs/sng_pvc/finetune_vae.sbatch's mirror step.
#
# Assumes rsync is available inside the container image (windinet1.sqsh) --
# if it isn't, swap for `cp -r --no-clobber` or add rsync to the image.
OUTPUT_ROOT=$(python -c 'from windinet.cluster_config import CLUSTER_DEFAULTS; print(CLUSTER_DEFAULTS["lrz_ai"]["output_root"])')
RUN_NAME=${OUT_DIR#"${OUTPUT_ROOT}/"}
LOCAL_DIR="finetune_vae_outputs/lrz_ai/${RUN_NAME}"
mkdir -p "${LOCAL_DIR}"
rsync -a --exclude='checkpoints/' "${OUT_DIR}/" "${LOCAL_DIR}/"
echo "Mirrored (excl. checkpoints/) to ${LOCAL_DIR}"
INNER

start_time=$(date +%s)
echo "Job started at: $(date)"

# No --pty: this is a batch job (submitted via sbatch, no attached terminal),
# not an interactive session -- --pty allocates a pseudo-terminal, which is
# for `srun --pty bash` style interactive use, not sbatch scripts.
srun \
  --container-image="/dss/dsshome1/09/ge26qux3/windinet1.sqsh" \
  --container-mounts=$HOME:$HOME,$RESULT_DIR:/mnt/result,$DATA_DIR:/mnt/data \
  --container-workdir="$HOME/work_wh/windinet" \
  --export=ALL,MASTER_PORT,MASTER_ADDR,WORLD_SIZE,CUDA_VISIBLE_DEVICES,BASE_CONFIG,WINDINET_HF_CACHE \
  bash "${INNER_SCRIPT}"

end_time=$(date +%s)
echo "Job finished at: $(date)"
echo "Total runtime: $((end_time - start_time)) seconds"
